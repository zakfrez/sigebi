<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="false" verbose="true">
  <testsuites>
    <testsuite name="original"><directory>tests/Original</directory></testsuite>
    <testsuite name="refactor"><directory>tests/Refactor</directory></testsuite>
  </testsuites>
  <!-- Cobertura medida sobre el código refactorizado (src/) -->
  <coverage processUncoveredFiles="true">
    <include><directory suffix=".php">src</directory></include>
  </coverage>
</phpunit>
